{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UTH Sync",
  "version": "0.2.6",
  "identifier": "com.hnamhocit.uth-sync",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "UTH Sync",
        "width": 1200,
        "height": 800,
        "decorations": false,
        "transparent": false,
        "maximized": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDQjlGMkFGM0I3MTg2RkQKUldUOWhuRTdyL0s1ckJ6Z09ObmNEakR4ck1vVnZKcDBQQk9qaFA4V2lWbzNTdXhSTmpMelkrYVEK",
      "endpoints": ["https://github.com/hnamhocit/uth-sync/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "publisher": "hnamhocit",
    "shortDescription": "Gọn gàng lịch học. Dứt điểm deadline.",
    "longDescription": "UTH Sync là ứng dụng được thiết kế dành riêng cho sinh viên UTH, giúp tự động đồng bộ hóa toàn bộ lịch học và bài tập, xua tan nỗi lo trễ deadline.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
