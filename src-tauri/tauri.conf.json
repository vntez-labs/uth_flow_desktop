{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UTH Sync",
  "version": "0.1.0",
  "identifier": "com.hnamhocit.uth-sync",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "UTH Sync",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDQjlGMkFGM0I3MTg2RkQKUldUOWhuRTdyL0s1ckJ6Z09ObmNEakR4ck1vVnZKcDBQQk9qaFA4V2lWbzNTdXhSTmpMelkrYVEK",
      "endpoints": ["https://github.com/hnamhocit/uth-sync/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
